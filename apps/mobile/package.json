{
  "name": "@fluxwp/mobile",
  "version": "0.3.2",
  "private": true,
  "description": "FluxWP mobile app (iOS + Android, Expo). Multi-site WordPress admin on top of Flux App.",
  "main": "index.ts",
  "scripts": {
    "postinstall": "node scripts/brand.cjs",
    "eas-build-pre-install": "cd ../.. && bun tools/fluxapp/brand.mjs && node apps/mobile/scripts/brand.cjs",
    "brand": "node scripts/brand.cjs",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "export": "expo export --platform all",
    "export:web": "expo export --platform web",
    "screenshots": "bun scripts/screenshots.ts",
    "test": "echo \"mobile: behaviour tests live in packages/runtime and packages/manifest\""
  },
  "dependencies": {
    "@expo/ui": "~58.0.27",
    "@fluxwp/core": "workspace:*",
    "@fluxwp/manifest": "workspace:*",
    "@fluxwp/runtime": "workspace:*",
    "@fluxwp/tokens": "workspace:*",
    "@hookform/resolvers": "^7.0.3",
    "@react-native/normalize-colors": "^0.88.1",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "^5.106.1",
    "expo": "~58.0.23",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.13",
    "expo-web-browser": "~58.0.7",
    "i18next": "^26.7.2",
    "lucide-react-native": "^1.69.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.13",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-unistyles": "^3.8.1",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "valibot": "^1.5.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "^58.0.4",
    "typescript": "~6.0.3"
  }
}
