{
  "id": "ai",
  "plugin": "flx-ai",
  "min_app": "1.0.0",
  "title": "Flux AI",
  "icon": "chat",
  "menu": "flx-ai",
  "entry": "settings",
  "tabs": ["settings", "log"],
  "fallback": { "web": "admin.php?page=flx-ai-settings" },
  "routes": {
    "admin.php?page=flx-ai": { "screen": "chat" },
    "admin.php?page=flx-ai-settings": { "screen": "settings" },
    "admin.php?page=flx-ai-log": { "screen": "log" },
    "admin.php?page=flx-ai-billing": { "screen": "billing" },
    "admin.php?page=flx-ai-systems": { "screen": "systems" },
    "admin.php?page=flx-ai-tools": { "screen": "tools" },
    "admin.php?page=flx-ai-mcp": { "screen": "mcp" }
  },
  "sources": {
    "log": {
      "path": "flx-ai/v1/log",
      "paging": { "mode": "page", "param": "page", "size_param": "per_page", "size": 25, "items": "items", "total": "total", "pages": "pages" },
      "key": "id",
      "cache": { "stale": 30 }
    }
  },
  "screens": {
    "settings": {
      "type": "settings",
      "title": "Ayarlar",
      "option": "flxai_settings",
      "write_cap": "manage_options",
      "fields": [
        { "name": "model", "type": "text", "label": "Varsayılan model" },
        { "name": "chat_model", "type": "text", "label": "Sohbet modeli" },
        {
          "name": "cache",
          "type": "select",
          "label": "Önbellek",
          "options": [
            { "value": "off", "label": "Kapalı" },
            { "value": "5m", "label": "5 dakika" },
            { "value": "1h", "label": "1 saat" }
          ]
        },
        {
          "name": "effort",
          "type": "segmented",
          "label": "Çaba",
          "options": [
            { "value": "low", "label": "Düşük" },
            { "value": "medium", "label": "Orta" },
            { "value": "high", "label": "Yüksek" }
          ]
        },
        { "name": "thinking", "type": "switch", "label": "Düşünme özeti" },
        { "name": "limit_day", "type": "number", "label": "Günlük sınır (USD)", "min": 0, "help": "0 sınırsız." },
        { "name": "limit_month", "type": "number", "label": "Aylık sınır (USD)", "min": 0 },
        {
          "name": "limit_action",
          "type": "segmented",
          "label": "Sınır aşılınca",
          "options": [
            { "value": "block", "label": "Durdur" },
            { "value": "warn", "label": "Uyar" }
          ]
        },
        { "name": "chat_admin", "type": "switch", "label": "Yönetimde sohbet" },
        { "name": "chat_front", "type": "switch", "label": "Sitede sohbet" },
        {
          "name": "chat_mode",
          "type": "segmented",
          "label": "Sohbet yerleşimi",
          "options": [
            { "value": "bubble", "label": "Pencere" },
            { "value": "dock", "label": "Yana sabit" }
          ]
        },
        { "name": "chat_instructions", "type": "textarea", "label": "Sohbet yönergesi" },
        { "name": "log_bodies", "type": "switch", "label": "İstek içeriğini kaydet" },
        { "name": "log_days", "type": "number", "label": "Kayıt saklama (gün)", "min": 0, "help": "0 sınırsız." },
        { "name": "log_body_days", "type": "number", "label": "İçerik saklama (gün)", "min": 0, "help": "0 sınırsız." },
        { "name": "key_openrouter", "type": "secret", "label": "OpenRouter anahtarı" },
        { "name": "key_anthropic", "type": "secret", "label": "Anthropic anahtarı" },
        { "name": "key_openai", "type": "secret", "label": "OpenAI anahtarı" },
        { "name": "key_gemini", "type": "secret", "label": "Gemini anahtarı" },
        { "name": "key_fal", "type": "secret", "label": "Fal anahtarı" },
        { "name": "key_evolink", "type": "secret", "label": "Evolink anahtarı" },
        { "name": "key_render", "type": "secret", "label": "Gotenberg anahtarı" }
      ]
    },
    "log": {
      "type": "list",
      "title": "Kayıtlar",
      "source": "log",
      "search": { "param": "q", "placeholder": "Model, araç ya da hata" },
      "filters": [
        {
          "param": "kind",
          "label": "Tür",
          "type": "select",
          "options": [
            { "value": "", "label": "Tümü" },
            { "value": "model", "label": "Model" },
            { "value": "tool", "label": "Araç" }
          ]
        }
      ],
      "columns": [
        { "label": "Kayıt", "value": "{{title}}", "width": 3 },
        { "label": "Kaynak", "value": "{{source}}" },
        { "label": "Süre", "value": "{{ms|number}}", "align": "end" },
        { "label": "Zaman", "value": "{{ts_label}}", "align": "end" }
      ],
      "item": {
        "title": "{{title}}",
        "subtitle": "{{source}}",
        "meta": "{{ms|number}}",
        "caption": "{{ts_label}}",
        "badges": [
          { "text": "Hata", "tone": "danger", "when": { "path": "ok", "op": "eq", "value": 0 } },
          { "text": "Araç", "tone": "muted", "when": { "path": "kind", "op": "eq", "value": "tool" } }
        ]
      },
      "actions": { "header": ["open_chat"] },
      "empty": { "title": "Kayıt yok", "body": "Model ve araç çağrıları burada listelenir. İstek içeriği uygulamaya gelmez." }
    },
    "chat": {
      "type": "native",
      "title": "Sohbet",
      "component": "flxai-chat",
      "fallback": { "web": "admin.php?page=flx-ai" }
    },
    "billing": { "type": "native", "title": "Faturalandırma", "component": "flxai-billing", "fallback": { "web": "admin.php?page=flx-ai-billing" } },
    "systems": { "type": "native", "title": "$t:aiSystems.title", "component": "flxai-systems", "fallback": { "web": "admin.php?page=flx-ai-systems" } },
    "tools": { "type": "native", "title": "Araçlar", "component": "flxai-tools", "fallback": { "web": "admin.php?page=flx-ai-tools" } },
    "mcp": { "type": "native", "title": "$t:aiMcp.title", "component": "flxai-mcp", "fallback": { "web": "admin.php?page=flx-ai-mcp" } }
  },
  "actions": {
    "open_chat": {
      "label": "Sohbet",
      "icon": "chat",
      "navigate": { "target": "screen:ai/chat" }
    }
  }
}
